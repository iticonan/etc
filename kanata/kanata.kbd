(defcfg
   process-unmapped-keys yes
   windows-altgr cancel-lctl-press
   linux-output-device-bus-type USB
   log-layer-changes yes
)

(deftemplate kpz (k fx fy zl)  ;; tap Key, hold goes to "Pointer Zone"
  (fork (multi $fx $fy (layer-toggle $zl))  ;;  see "Raton" layer 
        (tap-hold 150 150 $k (multi $fx $fy (layer-toggle $zl) (release-key ralt))) (ralt)))

(deftemplate gr (k act);; while in alt-gr 2+ keys or timeout -> mouse mode 
  (fork $act           ;; »» see "raton" layer 
        (tap-hold-press 130 140 $k (multi (release-key ralt) $act)) (ralt)))

;; tap one-shots to a "Pointer Zone", hold holds modifier
(deftemplate zm (pz m) (fork (tap-hold 150 150 (concat @pz $pz) $m) (concat @pz $pz) (nop0)))

(deftemplate th (t h) (fork (tap-hold 150 150 $t $h) $h (nop0) ))
(deftemplate thl (t hl) (fork (tap-hold 150 150 $t (layer-while-held $hl)) $t (nop0)))

(deftemplate ovz (fx fy zl) (multi    ;; One-shot Mouse Zone
    (on-press press-vkey $fx)  (on-release release-vkey $fx)
    (on-press press-vkey $fy)  (on-release release-vkey $fy)
    (one-shot-pause-processing 300)
    (one-shot 500 (layer-while-held $zl))))

(deftemplate n1^m (k o) 
   (switch (f24 nop1) $k break
           (lctl rctl lsft rsft lalt ralt lmet rmet) $o break
	   ()     $k break))

(defvirtualkeys
  vF13 (one-shot 600 F13)  vF14 (one-shot 600 F14)  vF15 (one-shot 600 F15)  
  vF16 (one-shot 600 F16)  vF17 (one-shot 600 F17)  vF18 (one-shot 600 F18)
)

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft  up
  lctl lmet lalt           spc            ralt rmet rctl left down right
)

(defhands
  (left q w e r t a s d f g lsft z x c v b)
  (right caps y u i o p [ h j k l ; ' n m , . / )
)

(deflayer qwerty
   grv 1    2    3    4    5    6    7    8    9    0    -    =    bspc
  @tab q    w    e    r    t    y    u    i    o    p    @bno ]    \
  @cap a    s    d    f    g    h    j    k    l    @psb  '  ret
  @sf1 z    x    c    v    b    n    m    ,    .    @ssf @sfw  up
   ctl lmet alt           spc            @rgr @ctp  @ctp left down right
)

(defalias
  met (multi lmet nop1)
  tab (multi nop9 (tap-hold-press 120 120 tab (layer-while-held fnnav)))
  bno (multi nop9 (tap-hold-press 120 120 [   (layer-while-held mouse)))

  cap (tap-hold 120 120 esc (multi (layer-while-held wmkp) 
      (tap-hold-opposite-hand 90 nop0 lmet)))
  psb (tap-hold 0 100 ; (layer-while-held psinkbols))

  sf1 (fork (one-shot-release 500 lsft) CapsLock (rsft))
  ssf (multi nop9 (tap-hold-press 120 120 / lsft))
  sfw (fork (tap-hold 130 130 (caps-word 2000) rsft) CapsLock (lsft))
  
  rgr (multi nop7 (tap-hold 120 150 ret (multi ralt (layer-while-held raton))))
  ctp (tap-hold 130 130 A-a rctl) ;;best tmux prefix ever

  m▲ (movemouse-accel-up    30 270 3 17)    w▲ (mwheel-up    150 120) 
  m▼ (movemouse-accel-down  30 270 3 17)    w▼ (mwheel-down  150 120) 
  m◀ (movemouse-accel-left  30 270 3 17)    w◀ (mwheel-left  150 120)
  m▶ (movemouse-accel-right 30 270 3 17)    w▶ (mwheel-right 150 120)

  qv▲ (t! gr q volu) wm« (t! gr w mbck) em▲ (t! gr e @m▲) rm» (t! gr r mfwd) tb▲ (t! gr t brup)    
  av▼ (t! gr a vold) sm◀ (t! gr s @m◀)  dm▼ (t! gr d @m▼) fm▶ (t! gr f @m▶)  gb▼ (t! gr g brdn)    
                     zw◀ (t! gr z @w◀)  xw▲ (t! gr x @w▲) cw▼ (t! gr c @w▼)  vw▶ (t! gr v @w▶)     

  uz7 (t! kpz u f13 f16 ptrtopleft)  iz8 (t! kpz i f14 f16 ptrtopmid)  oz9 (t! kpz o f15 f16 ptrtopright)
  jz4 (t! kpz j f13 f17 ptrmidleft)  kz5 (t! kpz k f14 f17 ptrmidmid)  lz6 (t! kpz l f15 f17 ptrmidright)
  mz1 (t! kpz m f13 f18 ptrlowleft)  ,z2 (t! kpz , f14 f18 ptrlowmid)  .z3 (t! kpz . f15 f18 ptrlowright)

  lsm (tap-hold 120 120 mute (multi lsft (layer-while-held qwerty)))
)

(deflayer raton
  grv  1     2    3    4    5           6         7     8     9    0 - = _
  tab  @qv▲ @wm« @em▲ @rm» @tb▲  (t! gr y mrgt) @uz7  @iz8  @oz9   p [ ] \
  caps @av▼ @sm◀ @dm▼ @fm▶ @gb▼  (t! gr h mmid) @jz4  @kz5  @lz6   ; ' _
  @lsm @zw◀ @xw▲ @cw▼ @vw▶  b    (t! gr n mlft) @mz1  @,z2  @.z3   / _ _
  lctl lmet lalt                   spc                ralt   _     _ _ _ _
)

(deflayer psinkbols
  _    _    _    _    _    _    _    _   _   _    _    _   _   _
 S-`  S-=  S-[  S-]  S-1   `   S-3  S-/ S-, S-.  _    _    _   _
  _   min  S-9  S-0   '   S-'  S-8   =  S-- S-5  ;    _    _
  \    [    ]   S-;  S-2   _   S-7  S-\ S-6 S-4  /    _    _
  _    _   bspc            spc          ret del del   _    _   _
)

(defalias
  eps (multi nop9 (tap-hold 120 120 esc (layer-while-held psinkbols)))
  pz7 (t! ovz vF13 vF16 ptrtopleft) pz8 (t! ovz vF14 vF16 ptrtopmid) pz9 (t! ovz vF15 vF16 ptrtopright)
  pz4 (t! ovz vF13 vF17 ptrmidleft) pz5 (t! ovz vF14 vF17 ptrmidmid) pz6 (t! ovz vF15 vF17 ptrmidright)
  pz1 (t! ovz vF13 vF18 ptrlowleft) pz2 (t! ovz vF14 vF18 ptrlowmid) pz3 (t! ovz vF15 vF18 ptrlowright)
  thz1ps (t! thl @pz1 psinkbols)
  tgnavmou (switch ((layer mouse)) (layer-switch fnnav) break
                   ((layer fnnav)) (layer-switch mouse) break)
  nav (switch ((base-layer qwerty)) (layer-switch mouse) break
              ()  (tap-hold 120 120 @tgnavmou (layer-while-held fnnav)) break)
  mou (switch ((base-layer qwerty)) (layer-switch fnnav) break
              ()  (tap-hold 120 120 @tgnavmou (layer-while-held mouse)) break)
  qwa (tap-hold 120 120 (layer-switch qwerty) @cap)
)

(deflayer mouse
  _     _   @2l  @3u @4d  @5r  _         @7◀◀           @8▶⏸           @9▶▶      _    _  _  _
 @nav brup C-S-↹ @m▲ C-↹ volu mrgt  (t! zm 7 ◀◀)   (t! zm 8 ▶⏸)   (t! zm 9 ▶▶)  ins @mou _  _  
 @qwa brdn  @m◀  @m▼ @m▶ vold mmid (t! zm 4 lsft) (t! zm 5 lctl) (t! zm 6 lmet) prnt  _  _    
  _    @w◀  @w▲  @w▼ @w▶  _   mlft      @thz1ps        @pz2            @pz3      _    _  _    
  _   @met   _     (tap-hold 120 120 spc nop0)         ralt            rmet     rctl  _  _  _
)
(deflayer fnnav
  _    _    @2l  @3u  @4d  @5r       _  @7◀◀ @8▶⏸ @9▶▶   _    _   _   _
 @nav ins   @F1◀ @F2▲ @F3▼ @F4▶     M-◀  M-▼  M-▲  M-▶  C-↹ @mou  _   _
 @qwa prnt  @F5M @F6C @F7S @F8▲      ◀    ▼    ▲    ▶  C-S-↹  _   _    
  _   @F9▼ @F10▲ @F11 @F12▼ mute   home pgdn  pgup end  mute  _   _    
  _   @met   _   (tap-hold 120 120 spc nop0)  ralt rmet rctl  _   _   _
)

(defalias  
  2l  (t! n1^m ◀  2)   3u  (t! n1^m ▲ 3)    4d  (t! n1^m ▼ 4)          5r(t! n1^m ▶ 5)
  7◀◀ (t! n1^m ◀◀ 7)   8▶⏸ (t! n1^m ▶⏸ 8)    9▶▶ (t! n1^m ▶▶ 9) 
  F1◀ (t! th F1 left)  F2▲ (t! th F2 up)     F3▼ (t! th F3 down)        F4▶ (t! th F4 right)
  F5M (t! th F5 lmet)  F6C (t! th F6 lctl)   F7S (t! th F7 lsft)        F8▲ (t! th F8 volu)
  F9▼ (t! th F9 brdn)  F10▲ (t! th F10 brup) F11 (t! thl F11 psinkbols) F12▼ (t! th F12 vold)
  k+p (t! thl kp+  psinkbols)
)

(deflayer wmkp
  _    _     _    _    _    _    _    _    kp*  kp/ bspc  _    _    _
  _    _     1    2    3    4   M-[   kp7  kp8  kp9 kp-   _    _    _
  _    _     5    6    7    8   M-]   kp4  kp5  kp6 @k+p  _    _
  _    9     0    -    =    _   M-\   kp1  kp2  kp3 kprt  _    _
  _   lrld   _             M-'             kp0  kp.  kp.  _    _    _
)

(defalias 
  x0y0 (multi  1 (setmouse $x0 $y0))     x1y0 (multi  2 (setmouse $x1 $y0)) 
  x0y1 (multi  q (setmouse $x0 $y1))     x1y1 (multi  w (setmouse $x1 $y1))
  x0y2 (multi  a (setmouse $x0 $y2))     x1y2 (multi  s (setmouse $x1 $y2))
  x0y3 (multi  z (setmouse $x0 $y3))     x1y3 (multi  x (setmouse $x1 $y3))
  x0y4 (multi  1 (setmouse $x0 $y4))     x1y4 (multi  2 (setmouse $x1 $y4))
  x0y5 (multi  q (setmouse $x0 $y5))     x1y5 (multi  w (setmouse $x1 $y5))
  x0y6 (multi  a (setmouse $x0 $y6))     x1y6 (multi  s (setmouse $x1 $y6))
  x0y7 (multi  z (setmouse $x0 $y7))     x1y7 (multi  x (setmouse $x1 $y7))
  x0y8 (multi  1 (setmouse $x0 $y8))     x1y8 (multi  2 (setmouse $x1 $y8))
  x0y9 (multi  q (setmouse $x0 $y9))     x1y9 (multi  w (setmouse $x1 $y9))
  x0ya (multi  a (setmouse $x0 $ya))     x1ya (multi  s (setmouse $x1 $ya))
  x0yb (multi  z (setmouse $x0 $yb))     x1yb (multi  x (setmouse $x1 $yb))

  x2y0 (multi  3 (setmouse $x2 $y0))     x3y0 (multi  4 (setmouse $x3 $y0)) 
  x2y1 (multi  e (setmouse $x2 $y1))     x3y1 (multi  r (setmouse $x3 $y1))
  x2y2 (multi  d (setmouse $x2 $y2))     x3y2 (multi  f (setmouse $x3 $y2))
  x2y3 (multi  c (setmouse $x2 $y3))     x3y3 (multi  v (setmouse $x3 $y3))
  x2y4 (multi  3 (setmouse $x2 $y4))     x3y4 (multi  4 (setmouse $x3 $y4))
  x2y5 (multi  e (setmouse $x2 $y5))     x3y5 (multi  r (setmouse $x3 $y5))
  x2y6 (multi  d (setmouse $x2 $y6))     x3y6 (multi  f (setmouse $x3 $y6))
  x2y7 (multi  c (setmouse $x2 $y7))     x3y7 (multi  v (setmouse $x3 $y7))
  x2y8 (multi  3 (setmouse $x2 $y8))     x3y8 (multi  4 (setmouse $x3 $y8))
  x2y9 (multi  e (setmouse $x2 $y9))     x3y9 (multi  r (setmouse $x3 $y9))
  x2ya (multi  d (setmouse $x2 $ya))     x3ya (multi  f (setmouse $x3 $ya))
  x2yb (multi  c (setmouse $x2 $yb))     x3yb (multi  v (setmouse $x3 $yb))

  x4y0 (multi  5 (setmouse $x4 $y0))     x5y0 (multi  1 (setmouse $x5 $y0)) 
  x4y1 (multi  t (setmouse $x4 $y1))     x5y1 (multi  q (setmouse $x5 $y1))
  x4y2 (multi  g (setmouse $x4 $y2))     x5y2 (multi  a (setmouse $x5 $y2))
  x4y3 (multi  b (setmouse $x4 $y3))     x5y3 (multi  z (setmouse $x5 $y3))
  x4y4 (multi  5 (setmouse $x4 $y4))     x5y4 (multi  1 (setmouse $x5 $y4))
  x4y5 (multi  t (setmouse $x4 $y5))     x5y5 (multi  q (setmouse $x5 $y5))
  x4y6 (multi  g (setmouse $x4 $y6))     x5y6 (multi  a (setmouse $x5 $y6))
  x4y7 (multi  b (setmouse $x4 $y7))     x5y7 (multi  z (setmouse $x5 $y7))
  x4y8 (multi  5 (setmouse $x4 $y8))     x5y8 (multi  1 (setmouse $x5 $y8))
  x4y9 (multi  t (setmouse $x4 $y9))     x5y9 (multi  q (setmouse $x5 $y9))
  x4ya (multi  g (setmouse $x4 $ya))     x5ya (multi  a (setmouse $x5 $ya))
  x4yb (multi  b (setmouse $x4 $yb))     x5yb (multi  z (setmouse $x5 $yb))

  x6y0 (multi  2 (setmouse $x6 $y0))     x7y0 (multi  3 (setmouse $x7 $y0)) 
  x6y1 (multi  w (setmouse $x6 $y1))     x7y1 (multi  e (setmouse $x7 $y1))
  x6y2 (multi  s (setmouse $x6 $y2))     x7y2 (multi  d (setmouse $x7 $y2))
  x6y3 (multi  x (setmouse $x6 $y3))     x7y3 (multi  c (setmouse $x7 $y3))
  x6y4 (multi  2 (setmouse $x6 $y4))     x7y4 (multi  3 (setmouse $x7 $y4))
  x6y5 (multi  w (setmouse $x6 $y5))     x7y5 (multi  e (setmouse $x7 $y5))
  x6y6 (multi  s (setmouse $x6 $y6))     x7y6 (multi  d (setmouse $x7 $y6))
  x6y7 (multi  x (setmouse $x6 $y7))     x7y7 (multi  c (setmouse $x7 $y7))
  x6y8 (multi  2 (setmouse $x6 $y8))     x7y8 (multi  3 (setmouse $x7 $y8))
  x6y9 (multi  w (setmouse $x6 $y9))     x7y9 (multi  e (setmouse $x7 $y9))
  x6ya (multi  s (setmouse $x6 $ya))     x7ya (multi  d (setmouse $x7 $ya))
  x6yb (multi  x (setmouse $x6 $yb))     x7yb (multi  c (setmouse $x7 $yb))

  x8y0 (multi  4 (setmouse $x8 $y0))     x9y0 (multi  5 (setmouse $x9 $y0)) 
  x8y1 (multi  r (setmouse $x8 $y1))     x9y1 (multi  t (setmouse $x9 $y1))
  x8y2 (multi  f (setmouse $x8 $y2))     x9y2 (multi  g (setmouse $x9 $y2))
  x8y3 (multi  v (setmouse $x8 $y3))     x9y3 (multi  b (setmouse $x9 $y3))
  x8y4 (multi  4 (setmouse $x8 $y4))     x9y4 (multi  5 (setmouse $x9 $y4))
  x8y5 (multi  r (setmouse $x8 $y5))     x9y5 (multi  t (setmouse $x9 $y5))
  x8y6 (multi  f (setmouse $x8 $y6))     x9y6 (multi  g (setmouse $x9 $y6))
  x8y7 (multi  v (setmouse $x8 $y7))     x9y7 (multi  b (setmouse $x9 $y7))
  x8y8 (multi  4 (setmouse $x8 $y8))     x9y8 (multi  5 (setmouse $x9 $y8))
  x8y9 (multi  r (setmouse $x8 $y9))     x9y9 (multi  t (setmouse $x9 $y9))
  x8ya (multi  f (setmouse $x8 $ya))     x9ya (multi  g (setmouse $x9 $ya))
  x8yb (multi  v (setmouse $x8 $yb))     x9yb (multi  b (setmouse $x9 $yb))

  xay0 (multi  1 (setmouse $xa $y0))     xby0 (multi  2 (setmouse $xb $y0)) 
  xay1 (multi  q (setmouse $xa $y1))     xby1 (multi  w (setmouse $xb $y1))
  xay2 (multi  a (setmouse $xa $y2))     xby2 (multi  s (setmouse $xb $y2))
  xay3 (multi  z (setmouse $xa $y3))     xby3 (multi  x (setmouse $xb $y3))
  xay4 (multi  1 (setmouse $xa $y4))     xby4 (multi  2 (setmouse $xb $y4))
  xay5 (multi  q (setmouse $xa $y5))     xby5 (multi  w (setmouse $xb $y5))
  xay6 (multi  a (setmouse $xa $y6))     xby6 (multi  s (setmouse $xb $y6))
  xay7 (multi  z (setmouse $xa $y7))     xby7 (multi  x (setmouse $xb $y7))
  xay8 (multi  1 (setmouse $xa $y8))     xby8 (multi  2 (setmouse $xb $y8))
  xay9 (multi  q (setmouse $xa $y9))     xby9 (multi  w (setmouse $xb $y9))
  xaya (multi  a (setmouse $xa $ya))     xbya (multi  s (setmouse $xb $ya))
  xayb (multi  z (setmouse $xa $yb))     xbyb (multi  x (setmouse $xb $yb))

  xcy0 (multi  3 (setmouse $xc $y0))     xdy0 (multi  4 (setmouse $xd $y0)) 
  xcy1 (multi  e (setmouse $xc $y1))     xdy1 (multi  r (setmouse $xd $y1))
  xcy2 (multi  d (setmouse $xc $y2))     xdy2 (multi  f (setmouse $xd $y2))
  xcy3 (multi  c (setmouse $xc $y3))     xdy3 (multi  v (setmouse $xd $y3))
  xcy4 (multi  3 (setmouse $xc $y4))     xdy4 (multi  4 (setmouse $xd $y4))
  xcy5 (multi  e (setmouse $xc $y5))     xdy5 (multi  r (setmouse $xd $y5))
  xcy6 (multi  d (setmouse $xc $y6))     xdy6 (multi  f (setmouse $xd $y6))
  xcy7 (multi  c (setmouse $xc $y7))     xdy7 (multi  v (setmouse $xd $y7))
  xcy8 (multi  3 (setmouse $xc $y8))     xdy8 (multi  4 (setmouse $xd $y8))
  xcy9 (multi  e (setmouse $xc $y9))     xdy9 (multi  r (setmouse $xd $y9))
  xcya (multi  d (setmouse $xc $ya))     xdya (multi  f (setmouse $xd $ya))
  xcyb (multi  c (setmouse $xc $yb))     xdyb (multi  v (setmouse $xd $yb))

  xey0 (multi  5 (setmouse $xe $y0))
  xey1 (multi  t (setmouse $xe $y1))
  xey2 (multi  g (setmouse $xe $y2))
  xey3 (multi  b (setmouse $xe $y3))
  xey4 (multi  5 (setmouse $xe $y4))
  xey5 (multi  t (setmouse $xe $y5))
  xey6 (multi  g (setmouse $xe $y6))
  xey7 (multi  b (setmouse $xe $y7))
  xey8 (multi  5 (setmouse $xe $y8))
  xey9 (multi  t (setmouse $xe $y9))
  xeya (multi  g (setmouse $xe $ya))
  xeyb (multi  b (setmouse $xe $yb))
)

;; TOP AREA
(deflayer ptrtopleft
_ @x0y0 @x1y0 @x2y0 @x3y0 @x4y0 _ _ _ _ _  _ _ _
_ @x0y1 @x1y1 @x2y1 @x3y1 @x4y1 _ _ _ _ _  [ ] \
_ @x0y2 @x1y2 @x2y2 @x3y2 @x4y2 _ _ _ _ _  ' _
  @x0y3 @x1y3 @x2y3 @x3y3 @x4y3 _ _ _ _ _ _  _ _
_ _ _ spc  _ _ _ _ _ _
)
(deflayer ptrtopmid
_ @x5y0 @x6y0 @x7y0 @x8y0 @x9y0 _ _ _ _ _ _ _ _
_ @x5y1 @x6y1 @x7y1 @x8y1 @x9y1 _ _ _ _ _ [ ] \
_ @x5y2 @x6y2 @x7y2 @x8y2 @x9y2 _ _ _ _ _ ' _
  @x5y3 @x6y3 @x7y3 @x8y3 @x9y3 _ _ _ _ _ _ _ _
_ _ _ spc  _ _ _ _ _ _
)
(deflayer ptrtopright
_ @xay0 @xby0 @xcy0 @xdy0 @xey0 _ _ _ _ _  _ _ _
_ @xay1 @xby1 @xcy1 @xdy1 @xey1 _ _ _ _ _  [ ] \
_ @xay2 @xby2 @xcy2 @xdy2 @xey2 _ _ _ _ _  ' _
  @xay3 @xby3 @xcy3 @xdy3 @xey3 _ _ _ _ _ _  _ _
_ _ _ spc  _ _ _ _ _ _
)

;;;;; MID AREA 
(deflayer ptrmidleft
_ @x0y4 @x1y4 @x2y4 @x3y4 @x4y4 _ _ _ _ _ _ _ _
_ @x0y5 @x1y5 @x2y5 @x3y5 @x4y5 _ _ _ _ _ [ ] \
_ @x0y6 @x1y6 @x2y6 @x3y6 @x4y6 _ _ _ _ _ ' _
  @x0y7 @x1y7 @x2y7 @x3y7 @x4y7 _ _ _ _ _ _ _ _
_ _ _ spc  _ _ _ _ _ _
)
